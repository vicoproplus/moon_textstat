## 4. 前后哈希比对

```console
$ cd "F:/moonbit比赛/moon_textstat" && python - <<'PY'
import hashlib, json, os
SNAP = r"F:\Temp\t08_snapshot_zbn94_v1"
before = json.load(open(os.path.join(SNAP, "snapshot.json"), encoding="utf-8"))
bad = 0
for rel in sorted(before):
    b = open(rel, "rb").read()
    after = {"bytes": len(b), "sha256": hashlib.sha256(b).hexdigest()}
    same = after == before[rel]
    copy = open(os.path.join(SNAP, rel.replace("/", "__")), "rb").read()
    copy_same = copy == b
    bad += 0 if (same and copy_same) else 1
    print("AFTER  %-52s bytes=%d sha256=%s" % (rel, after["bytes"], after["sha256"]))
    print("VERDICT %-51s %s (copy_identical=%s)" % (rel, "IDENTICAL" if same else "CHANGED", copy_same))
print("COMPARED=%d CHANGED=%d" % (len(before), bad))
PY
