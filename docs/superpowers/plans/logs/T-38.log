$ moon run cmd/gate --target native --group=selfcheck --inject=1 | tail -1
cells=366 passed=365 floor=366 group=selfcheck inject=1
$ echo ${PIPESTATUS[0]}
1
$ out=$(moon run cmd/gate --target native --group=selfcheck --inject=1); echo EXIT=$?
EXIT=1
$ printf '%s\n' "$out" | wc -l
2
$ printf '%s\n' "$out" | sed -n '1,2p'
moon run cmd/gate --target native
cells=366 passed=365 floor=366 group=selfcheck inject=1
```

末行逐字为 `cells=366 passed=365 floor=366 group=selfcheck inject=1`，
`${PIPESTATUS[0]}`=1，stdout 恰 2 行。

