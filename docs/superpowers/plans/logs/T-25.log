resolved pl [206.835, 1.015, 84.6, 4]
resolved ru [206.835, 1.3, 60.1, 3]
resolved hu [206.835, 1.015, 58.5, 5]
code en_US -> 'en' [206.835, 1.015, 84.6, 3]
code en_GB -> 'en' [206.835, 1.015, 84.6, 3]
code de_DE -> 'de' [180, 1, 58.5, 3]
code es_ES -> 'es' [206.84, 1.02, 60.0, 3]
code fr_FR -> 'fr' [207, 1.015, 73.6, 3]
