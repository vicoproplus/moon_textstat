code nl_NL -> 'nl' [206.835, 0.93, 77, 3]
code pl_PL -> 'pl' [206.835, 1.015, 84.6, 4]
code ru_RU -> 'ru' [206.835, 1.3, 60.1, 3]
code hu_HU -> 'hu' [206.835, 1.015, 58.5, 5]
